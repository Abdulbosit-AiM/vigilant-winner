# vigilant-winner / Maternify — environment variables
# Copy this file to .env.local and fill in real values. NEVER commit .env.local.
# No auth and no PII stored — Supabase holds only public corpus text + anonymous events.

# --- AI (generation) ---
# GLM-5.1 (Z.ai, OpenAI-compatible endpoint) — primary generator for Express/Interpret.
GLM_API_KEY=
# Optional overrides (defaults shown):
# GLM_BASE_URL=https://api.z.ai/api/paas/v4
# GLM_MODEL=glm-5.1

# --- AI (Gemini: fallback generation, embeddings, TTS, STT, OCR) ---
# Live fallback generator + gemini-embedding-001 (RAG index) +
# gemini-2.5-flash-preview-tts (English-script audio — the demo moment) +
# multimodal STT (voice input) + vision OCR (letter photos).
GEMINI_API_KEY=
# Optional overrides (defaults shown):
# GEMINI_TEXT_MODEL=gemini-2.5-flash
# GEMINI_EMBED_MODEL=gemini-embedding-001
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# --- Supabase (corpus text backup + anonymous events — no auth, no PII) ---
# Embeddings live ONLY in data/corpus/index.json, never in the DB.
# Use the publishable (or legacy anon) key — NEVER the service-role key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# (legacy name also accepted: SUPABASE_ANON_KEY=)

# --- Demo safety ---
# When true, the app serves saved, clearly-labelled example fixtures instead of
# live AI calls (and on any live-call failure). See docs/judge-rubric.md.
DEMO_SAFE_MODE=false

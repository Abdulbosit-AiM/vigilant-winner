# vigilant-winner / Maternify — environment variables
# Copy this file to .env.local and fill in real values. NEVER commit .env.local.
# The hackathon build has no database and no auth — two secrets only.

# --- AI (generation) ---
# Claude Sonnet (Express generation) + Claude Haiku (RAG summarisation)
ANTHROPIC_API_KEY=

# --- AI (embeddings + TTS) ---
# text-embedding-3-small for the in-memory RAG index + OpenAI TTS for the
# English-script audio playback (the demo moment)
OPENAI_API_KEY=

# --- NHS developer hub (optional for the demo; needed for live grounding) ---
# Free trial subscription key for the NHS Website Content API (RAG corpus content)
# and the NHS Service Search API (local maternity service signposting).
# See docs/health/NHS-RESOURCES.md. Leave blank to run on the pre-indexed corpus.
NHS_API_SUBSCRIPTION_KEY=

# --- Demo safety ---
# When true, the app serves a saved, clearly-labelled example instead of a live
# AI call if credentials/network fail on stage. See docs/judge-rubric.md.
DEMO_SAFE_MODE=false
